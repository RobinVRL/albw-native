+/* (T *)<float expr>: a register/slot copy of the 32 bits, never a conversion */
+#define ALBW_PTR_BITS(x) _Generic((x), \
+    float: (uintptr_t)albw_bits_u32(_Generic((x), float: (x), default: 0.0f)), \
+    default: (x))
+/* X._0_3_ = v: the 3 low bytes (strh + strb) */
